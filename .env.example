# 默认使用确定性 mock，离线开发不需要真实模型密钥。
# 要运行 Stage 02 真实冒烟，将 AI_PROVIDER 改为 deepseek，并只在 .env.local 填写 Key。
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com
AI_MODEL_PRIMARY=deepseek-v4-flash
AI_MODEL_ESCALATION=deepseek-v4-pro
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_ESCALATION_CONFIDENCE=0.8
AI_MAX_OUTPUT_TOKENS=8192

# Stage 03 审核后台：本地开发可使用 local；托管环境必须使用 chatgpt 并设置邮箱白名单。
REVIEW_AUTH_MODE=local
REVIEW_ADMIN_EMAILS=
# 可选的服务端审核 API Token；至少 32 字符，必须作为托管 Secret 保存。
REVIEW_AUTOMATION_TOKEN=

# Stage 05 定时采集：每 30 分钟触发；单次限制来源、并发、每源条数和 AI 分析量。
# auto 只在 AI_PROVIDER=deepseek 时自动分析；mock 环境只采集，不生成伪候选。
INGESTION_SOURCE_BATCH_SIZE=20
INGESTION_SOURCE_CONCURRENCY=3
INGESTION_MAX_ITEMS_PER_SOURCE=10
INGESTION_ANALYSIS_BATCH_SIZE=6
INGESTION_ANALYSIS_CONCURRENCY=3
INGESTION_ANALYSIS_MODE=auto

# Stage 16 外部定时入口：单次采用更小批次，避免托管 HTTP 请求超时。
EXTERNAL_REFRESH_SOURCE_BATCH_SIZE=5
EXTERNAL_REFRESH_SOURCE_CONCURRENCY=3
EXTERNAL_REFRESH_ANALYSIS_BATCH_SIZE=6
EXTERNAL_REFRESH_ANALYSIS_CONCURRENCY=3

# Stage 17 保守自动发布：默认关闭；生产经验证后才设为 safe。
# safe 仅允许官方来源、高置信度、无风险标记的非高风险事件通过质量门禁后发布。
AUTO_PUBLISH_MODE=off
AUTO_PUBLISH_MIN_CONFIDENCE=0.9
AUTO_PUBLISH_BATCH_SIZE=1

# 仅供外部调度器运行 scripts/run-external-refresh.mjs；不得提交真实值。
MOKUANG_SITE_URL=https://mokuang-ai-radar.example.com
SITES_BYPASS_TOKEN=

# Stage 09 邮件：本地默认只写入 D1 outbox；生产改为 resend 并配置已验证发信域名。
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=模况 <digest@example.com>
PUBLIC_SITE_URL=http://localhost:3000
